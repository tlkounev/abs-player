{
  "name": "abs-player-win",
  "productName": "ABS Player",
  "version": "1.3.2",
  "description": "ABS Player pro Windows – Audiobookshelf v oznamovací oblasti",
  "main": "src/main.js",
  "author": "Ondra",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/sync-reader.js && electron .",
    "dist": "node scripts/sync-reader.js && node scripts/gen-icons.js && node scripts/gen-flags.js && electron-builder --win --x64 --publish never",
    "flags": "node scripts/gen-flags.js",
    "icons": "node scripts/gen-icons.js",
    "test": "node --test test/remote.test.js",
    "test:ui": "electron test/harness.js"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.abs-player",
    "productName": "ABS Player",
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/tlkounev/abs-player/releases/download/win-latest"
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/app.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ABS Player",
      "artifactName": "ABS-Player-Setup-${version}.${ext}"
    }
  }
}
