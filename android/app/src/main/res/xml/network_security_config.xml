<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- ABS on the LAN often runs on plain http, and the TV receiver is http on the LAN.
         User-installed CAs are trusted so a self-signed reverse proxy works too. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
